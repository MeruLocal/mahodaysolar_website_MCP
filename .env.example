# Placeholders only. This server needs no credentials.
PORT=3000
MCP_HTTP_HOST=127.0.0.1
# Public origin used in the server card and llms.txt (unconfirmed host)
MCP_PUBLIC_URL=https://mcp.mahodaysolar.com
# Extra Host header values accepted behind a proxy; "*" disables rebinding protection
MCP_ALLOWED_HOSTS=
# 1 = take the client IP from X-Forwarded-For (only behind a proxy you control)
MCP_TRUST_PROXY=0
MCP_RATE_LIMIT_PER_MIN=60
MAHODAYSOLAR_SITE_URL=https://mahodaysolar.com
# Owner-confirmed facts. Leave empty until true; empty fields are omitted from answers.
MAHODAYSOLAR_PHONE=
MAHODAYSOLAR_EMAIL=
MAHODAYSOLAR_ADDRESS=
MAHODAYSOLAR_LEGAL_ENTITY=
MAHODAYSOLAR_SERVICE_AREA=
