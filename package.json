{
  "name": "mahodaysolar-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only MCP server for Mahoday Solar: sizing and EMI calculators, subsidy pointers to official sources, AMC checklists, and canonical page citations. Static content, no outbound requests.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20.0.0" },
  "mcpName": "io.github.merulocal/mahodaysolar",
  "bin": { "mahodaysolar-mcp": "dist/index.js" },
  "main": "dist/index.js",
  "files": ["dist", "public", "README.md", ".env.example"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "audit:live": "node scripts/audit-live.mjs",
    "gen:pages": "node --experimental-strip-types scripts/gen-site-pages.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
